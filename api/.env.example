# Comply API — Variables d'environnement
# Copiez ce fichier en .env

CLAUDE_API_KEY=sk-ant-api03-...
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096
TEMPERATURE=0.1
DATA_DIR=./data
VECTOR_DB_PATH=./chroma_db
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CONTEXT_DOCS=6
MIN_CONFIDENCE=0.35
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5
CNJE_TICKET_URL=https://support.junior-entreprises.com/hc/fr/requests/new

# ── Notion ────────────────────────────────────────────────────────────────────
# Créer une intégration sur https://www.notion.so/my-integrations
# Puis partager vos pages/databases avec l'intégration
NOTION_API_KEY=secret_...
# IDs de pages à indexer (séparés par virgule) — laisser vide pour tout indexer
NOTION_PAGE_IDS=
# IDs de databases à indexer (séparés par virgule)
NOTION_DATABASE_IDS=

# ── Google Drive ──────────────────────────────────────────────────────────────
# Option 1 : Compte de service (recommandé pour un usage org)
# Créer un compte de service sur https://console.cloud.google.com/iam-admin/serviceaccounts
# Télécharger le JSON et coller son contenu ici (sur une seule ligne)
GOOGLE_DRIVE_SERVICE_ACCOUNT=
# Option 2 : Token OAuth (usage personnel)
GOOGLE_DRIVE_TOKEN_FILE=./drive_token.json
# Dossier Drive à indexer (ID dans l'URL Drive)
GOOGLE_DRIVE_FOLDER_ID=
# Shared Drive ID (optionnel)
GOOGLE_DRIVE_SHARED_DRIVE_ID=
