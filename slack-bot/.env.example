# Comply Slack Bot — Variables d'environnement
# Copiez ce fichier en .env

# ── Slack App ─────────────────────────────────────────────────────────────────
# Créer une app sur https://api.slack.com/apps
# Activer Socket Mode + ajouter les scopes : app_mentions:read, chat:write,
# commands, im:history, im:read, im:write

# Token du bot (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-...

# Signing Secret (Basic Information → App Credentials)
SLACK_SIGNING_SECRET=...

# App-Level Token (Settings → Basic Information → App-Level Tokens, scope: connections:write)
SLACK_APP_TOKEN=xapp-...

# ── API Comply ────────────────────────────────────────────────────────────────
# URL de l'API Comply (en local ou Docker)
API_URL=http://localhost:8000
